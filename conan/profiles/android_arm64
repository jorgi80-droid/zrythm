# Android ARM64 host profile. Run with a Linux build profile via -pr:b ci_clang_19.
include(_common)
include(_qt_common)

[settings]
os=Android
os.api_level=28
arch=armv8
build_type=Release
compiler=clang
compiler.version=19
compiler.libcxx=c++_shared
compiler.cppstd=23

[tool_requires]
*: android-ndk/r28c

[options]
qt/*:opengl=es2
qt/*:with_dbus=False
qt/*:with_fontconfig=False
qt/*:with_freetype=True
qt/*:with_egl=True
qt/*:with_x11=False
qt/*:qtwayland=False
qt/*:with_icu=False
qt/*:with_libjpeg=False
qt/*:with_pq=False
qt/*:with_odbc=False
qt/*:with_sqlite3=False
qt/*:with_glib=False
qt/*:qtcanvaspainter=True

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
